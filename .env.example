# Supabase (Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Cloudinary (Dashboard > Cloud name)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME

# Cloudinary upload presets en modo "Unsigned" (Settings > Upload > Upload presets)
# Productos y QR de pago
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=TU_PRESET_UNSIGNED
# Comprobantes de pago de los clientes (puede ser el mismo preset)
EXPO_PUBLIC_CLOUDINARY_PROOF_PRESET=TU_PRESET_COMPROBANTES
